# Reference list of environment variables ColivSync understands.
# NOTE: the app does not auto-load a .env file - set these as real environment
# variables (PowerShell: $env:PORT=5000) or in your host's dashboard (Render).
# Never commit real secrets.

# Port the Express server listens on (hosts like Render set this automatically)
PORT=5000

# "production" disables the built-in demo admin password
NODE_ENV=development

# Password for admin@colivsync.com (min 8 chars).
# REQUIRED in production, otherwise the admin account has no password.
COLIVSYNC_ADMIN_PASSWORD=ChangeMe@12345

# Optional: location of the SQLite file (point at a persistent disk in production)
# COLIVSYNC_DB_PATH=/var/data/colivsync.db

# Optional: folder for maintenance-request photos
# COLIVSYNC_UPLOAD_DIR=/var/data/uploads
